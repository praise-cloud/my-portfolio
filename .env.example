# =============================================
# FRONTEND ENVIRONMENT VARIABLES (VITE_*)
# These are compiled into the browser bundle,
# so NEVER put secrets here.
# =============================================

# Where the backend server lives.
# In dev, Vite proxies /api/* requests to this address.
# In production, deploy your backend to a server/function and
# change this to its URL.
VITE_API_BASE=http://localhost:4000

# Social feed API endpoints on YOUR backend.
# Each returns { posts: [...] } with the latest post.
# Change these only if you rename the backend routes.
VITE_LINKEDIN_ENDPOINT=/api/linkedin/recent
VITE_INSTAGRAM_ENDPOINT=/api/instagram/recent
VITE_THREADS_ENDPOINT=/api/threads/recent
VITE_TIKTOK_ENDPOINT=/api/tiktok/recent



# =============================================
# BACKEND ENVIRONMENT VARIABLES (server-only)
# Your backend server reads these from process.env.
# They are NEVER sent to the browser.
# =============================================

# --- LinkedIn ---
# Create an app at https://developer.linkedin.com
# Under "Products", request "Share on LinkedIn" and "Sign In with LinkedIn"
# Set the OAuth 2.0 redirect URL to http://localhost:4000/auth/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_USER_URN=  (your LinkedIn profile URN, e.g. urn:li:person:abc123)

# --- Instagram ---
# Create an app at https://developers.facebook.com
# Add "Instagram Basic Display" product
# Set the OAuth redirect URL to http://localhost:4000/auth/instagram/callback
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_ACCESS_TOKEN=  (long-lived token from the auth flow)

# --- Threads ---
# Create an app at https://developers.facebook.com (Meta for Developers)
# Add "Threads" API product
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
# THREADS_ACCESS_TOKEN=  (long-lived token from the auth flow)

# --- TikTok ---
# Create an app at https://developers.tiktok.com
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=  (long-lived token from the auth flow)
